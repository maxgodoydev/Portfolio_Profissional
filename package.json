{
  "name": "max-godoy-portfolio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Portfólio de Max Godoy — React + TypeScript (frontend) e Go (API).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs --preview",
    "typecheck": "tsc --noEmit",
    "api": "go run ./cmd/server",
    "test:api": "go test ./...",
    "test:web": "node --test \"tests/*.test.mjs\"",
    "verify": "node scripts/verify-dist.mjs",
    "e2e:admin": "node scripts/e2e-admin.mjs",
    "a11y": "node scripts/a11y-check.mjs",
    "test": "npm run typecheck && npm run test:web && npm run build && npm run verify && npm run test:api"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.0"
  }
}
