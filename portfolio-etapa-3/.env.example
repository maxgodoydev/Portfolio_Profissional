# Copie para .env (local) e configure as mesmas variáveis no painel da Vercel
# (Project → Settings → Environment Variables). NUNCA faça commit do .env real.

# --- Ambiente ---
# development | preview | production (na Vercel é definido automaticamente por VERCEL_ENV)
APP_ENV=development
# Porta da API local (go run ./cmd/server)
PORT=8080
# Origens extras permitidas por CORS (separadas por vírgula). Normalmente vazio:
# o site e a API compartilham a mesma origem.
ALLOWED_ORIGINS=

# --- Banco de métricas (Turso) ---
# Sem estas duas variáveis a API usa memória: serve para desenvolvimento, NÃO persiste em produção.
TURSO_DATABASE_URL=libsql://seu-banco-sua-org.turso.io
TURSO_AUTH_TOKEN=

# --- Área administrativa (/admin) ---
# Segredo longo e aleatório (mínimo 32 caracteres). Assina o cookie e gera hashes anônimos.
# Defina também em produção sem usar o /admin: sem ele os hashes usam um segredo aleatório por instância.
SESSION_SECRET=
# Use UMA das duas opções abaixo. A opção com hash evita guardar a senha em texto:
ADMIN_PASSWORD_SHA256=
ADMIN_PASSWORD=

# --- Formulário de contato (Resend) ---
RESEND_API_KEY=
# Para onde as mensagens são entregues
CONTACT_TO_EMAIL=
# Remetente. Com domínio não verificado, o Resend só permite onboarding@resend.dev
CONTACT_FROM_EMAIL=Portfólio <onboarding@resend.dev>

# --- Build do frontend (opcional) ---
# URL pública usada em canonical, sitemap e hreflang
SITE_URL=https://max-godoy-portfolio.vercel.app
